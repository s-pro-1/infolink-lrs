# Copy to .env for local development. Never commit the real .env.
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave unset for local SQLite. In production use the PostgreSQL URL:
# DATABASE_URL=postgres://user:password@host:5432/dbname
PLATFORM_NAME=Learning Resource Hub
INSTITUTION_NAME=Infolink University College
PRIMARY_COLOR=#1f4e79
CSRF_TRUSTED_ORIGINS=

# Uploads
MAX_UPLOAD_MB=20
UPLOADS_PER_HOUR=20
# Malware scanning (optional locally). Example:
# RESOURCE_SCANNER=apps.resources.scanning.ClamAVScanner
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
